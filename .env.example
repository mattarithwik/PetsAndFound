SPACETIME_URI=http://127.0.0.1:3000
SPACETIME_DATABASE=pawsafe
SPACETIME_SERVICE_TOKEN=
PORT=8080

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional JSON array of Shelterluv groups; defaults to Dallas Pets Alive (group 3451).
# Each entry: {"id":"3451","name":"Dallas Pets Alive","address":"...","city":"Dallas, TX","latitude":32.81,"longitude":-96.86}
SHELTERLUV_GROUPS=
# Process public Shelterluv listing photos for review-required match proposals.
SHELTERLUV_IMAGE_MATCHING=true

VISION_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_SECRET=
# Set only after measuring a notification cutoff on labeled animals.
MATCH_NOTIFY_THRESHOLD=
INGEST_INTERVAL_MS=900000
# Exact image hosts the matching service may fetch.
EXTERNAL_IMAGE_HOSTS=new-s3.shelterluv.com
# Additional approved publishers for other external sources.
EXTERNAL_IMAGE_RIGHTSHOLDERS=
PROVIDER_USER_AGENT=
PHOTON_URL=https://photon.komoot.io/api/
BSKY_PDS_URL=
BSKY_ACCESS_JWT=
